<Window x:Class="Lancom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Lancom.App.ViewModels"
        xmlns:utils="clr-namespace:Lancom.App.Utils"
        mc:Ignorable="d"
        Title="Lancom" Height="720" Width="440"
        Icon="app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utils:Base64ImageConverter x:Key="Base64ImageConverter" />
        <utils:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        <utils:RogerBeepDescriptionConverter x:Key="RogerBeepDescConverter" />

        <Style x:Key="ChannelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252834" />
            <Setter Property="Foreground" Value="#E0E3EA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="AllCallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3D1E22" />
            <Setter Property="Foreground" Value="#FF6B72" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <!-- Main Outer Container with Drop Shadow & Rounded Border -->
    <Border Background="{StaticResource BrushBgDark}" 
            BorderBrush="{StaticResource BrushBorderDark}" 
            BorderThickness="1.5" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Compact HUD Pill -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Expandable Command Deck -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================================================== -->
            <!-- HEADER / COMPACT HUD PILL                                 -->
            <!-- ======================================================== -->
            <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" 
                    CornerRadius="14,14,0,0" Padding="14,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Channel Badge Pill with App Icon & E2EE Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Image Source="app.ico" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Border Background="#242731" CornerRadius="8" Padding="8,4">
                            <TextBlock Text="{Binding CurrentChannelDisplay}" 
                                       Foreground="{StaticResource BrushAccentEmerald}" 
                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#1C2321" BorderBrush="#2D483A" BorderThickness="1" CornerRadius="6" Padding="5,2" Margin="5,0,0,0" ToolTip="{Binding E2eeStatusText}">
                            <TextBlock Text="{Binding E2eeIcon}" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Center Header / Drag Area -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="LANCOM INTERCOM" 
                                   Foreground="{StaticResource BrushTextMuted}" 
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                   Opacity="0.75" />
                    </StackPanel>

                    <!-- Window Control Micro-Buttons & Banner Settings Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsToggleButton" 
                                Content="{Binding SettingsButtonText}" 
                                Style="{StaticResource BannerSettingsButtonStyle}" 
                                Click="SettingsButton_Click" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="Hold-to-Talk Key, Roger Beep, and Network Settings" />
                        <Button Content="—" Width="26" Height="26" Margin="0,0,4,0"
                                Background="#2A2D37" Foreground="#A0A5B5" BorderThickness="0"
                                Click="Minimize_Click" Cursor="Hand" />
                        <Button Content="✕" Width="26" Height="26"
                                Background="#3A2226" Foreground="#FF6B72" BorderThickness="0"
                                Click="Close_Click" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- COMMAND DECK & SETTINGS FLYOUT DRAWER                     -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1">
                <!-- Main Command Deck -->
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <!-- Audio Meters & Quick PTT Button -->
                        <RowDefinition Height="Auto" />
                        <!-- Channel Grid Selector -->
                        <RowDefinition Height="Auto" />
                        <!-- Online Colleagues Roster -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <!-- Audio VU Meter, Voicemail Alert, PTT Button & Quick Replay -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <!-- Voicemail Missed Memo Alert Banner -->
                    <Border Visibility="{Binding VoicemailBannerVisibility}" 
                            Background="#2D1A1E" BorderBrush="#FF5252" BorderThickness="1" 
                            CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding VoicemailBannerText}" 
                                       Foreground="#FF8A80" FontWeight="Bold" FontSize="11" 
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="▶ Play" Click="PlayVoicemail_Click" 
                                     Background="#442226" Foreground="#FFD180" BorderThickness="0" 
                                     Padding="8,3" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0" />
                            <Button Grid.Column="2" Content="✕" Click="DismissVoicemail_Click" 
                                     Background="Transparent" Foreground="#A5AAB8" BorderThickness="0" 
                                     Padding="6,3" FontSize="10" Cursor="Hand" ToolTip="Dismiss Voicemails" />
                        </Grid>
                    </Border>

                    <!-- Active 1-on-1 Whisper Target Banner -->
                    <Border Visibility="{Binding WhisperBannerVisibility}" 
                            Background="#281335" BorderBrush="#C026D3" BorderThickness="1" 
                            CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟣 PRIVATE LINE:" Foreground="#E879F9" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding WhisperTargetName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕ CANCEL" Click="ClearWhisper_Click" 
                                    Background="#4A1D5A" Foreground="#F5D0FE" BorderThickness="0" 
                                    Padding="8,3" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="Return to Channel Broadcast" />
                        </Grid>
                    </Border>

                    <!-- Audio Level Bar -->
                    <Grid Height="8" Margin="0,0,0,12">
                        <ProgressBar Height="8" Minimum="0" Maximum="1" 
                                     Value="{Binding ActiveSpeakerLevel, Mode=OneWay}" 
                                     Foreground="{StaticResource BrushAccentEmerald}" 
                                     Background="#22252E" BorderThickness="0" />
                        <ProgressBar Height="8" Minimum="0" Maximum="1" 
                                     Value="{Binding LocalMicLevel, Mode=OneWay}" 
                                     Foreground="{StaticResource BrushAccentAmber}" 
                                     Background="Transparent" BorderThickness="0" />
                    </Grid>

                    <!-- Tactical Live Transmission Status Banner (Above HOLD TO TALK) -->
                    <Border CornerRadius="8" Padding="12,7" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#171A23" />
                                <Setter Property="BorderBrush" Value="#292D3B" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                        <Setter Property="Background" Value="#38220A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentAmber}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReceivingWhisper}" Value="True">
                                        <Setter Property="Background" Value="#2D133B" />
                                        <Setter Property="BorderBrush" Value="#C026D3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReceiving}" Value="True">
                                        <Setter Property="Background" Value="#0D2C1C" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentEmerald}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Transmit / Receive Pulse Indicator -->
                            <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555866" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushAccentAmber}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReceivingWhisper}" Value="True">
                                                <Setter Property="Fill" Value="#E879F9" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReceiving}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushAccentEmerald}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Grid.Column="1" Text="{Binding TacticalStatusBannerText}" 
                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentAmber}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReceivingWhisper}" Value="True">
                                                <Setter Property="Foreground" Value="#F5D0FE" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReceiving}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentEmerald}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Channel Badge -->
                            <Border Grid.Column="2" Background="#12141C" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentChannelDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Big Tactile Push-To-Talk Button -->
                    <Border CornerRadius="12" Cursor="Hand" Height="58"
                            PreviewMouseDown="PttButton_PreviewMouseDown" 
                            PreviewMouseUp="PttButton_PreviewMouseUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#252834" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushAccentAmber}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="HOLD TO TALK" FontWeight="Bold" FontSize="15" 
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                                <Setter Property="Foreground" Value="#000000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding PttKeyDisplay}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" 
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Live Subtitle / Speech-to-Text Banner -->
                    <Border CornerRadius="8" Padding="10,7" Margin="0,8,0,0" Background="#161922" BorderBrush="#2D3244" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSubtitle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💬" FontSize="11" VerticalAlignment="Top" Margin="0,1,6,0" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11" LineHeight="16">
                                <Run Text="{Binding SubtitleSender, Mode=OneWay}" FontWeight="Bold" Foreground="#6EE7B7" />
                                <Run Text=": " Foreground="#8A92A6" />
                                <Run Text="{Binding SubtitleText, Mode=OneWay}" Foreground="#F1F3F9" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Quick Action Row: Instant Replay ("Say Again") & Local AFK Status -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Replay Last Transmission ("Say Again") Button -->
                        <Button Grid.Column="0" Content="{Binding LastReplayInfo}" 
                                IsEnabled="{Binding CanReplay}"
                                Click="Replay_Click"
                                Background="#1E222D" Foreground="{StaticResource BrushAccentEmerald}"
                                BorderBrush="#2C3242" BorderThickness="1"
                                Padding="8,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                HorizontalAlignment="Left"
                                ToolTip="Replay the last received voice transmission" />

                        <!-- Local User Status Pill -->
                        <Border Grid.Column="1" Background="#1E212B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource BrushAccentEmerald}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocalAfk}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource BrushAccentAmber}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LocalStatusText}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Channel Grid (Channels 1-8 + All-Call) -->
                <Border Grid.Row="1" Background="{StaticResource BrushBgCard}" 
                        CornerRadius="10" Padding="10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CHANNELS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
                        <UniformGrid Columns="4" Rows="2">
                            <Button Content="CH 01" Margin="2" Padding="4,6" Click="Channel_Click" Tag="1" Style="{StaticResource ChannelButtonStyle}" />
                            <Button Content="CH 02" Margin="2" Padding="4,6" Click="Channel_Click" Tag="2" Style="{StaticResource ChannelButtonStyle}" />
                            <Button Content="CH 03" Margin="2" Padding="4,6" Click="Channel_Click" Tag="3" Style="{StaticResource ChannelButtonStyle}" />
                            <Button Content="CH 04" Margin="2" Padding="4,6" Click="Channel_Click" Tag="4" Style="{StaticResource ChannelButtonStyle}" />
                            <Button Content="CH 05" Margin="2" Padding="4,6" Click="Channel_Click" Tag="5" Style="{StaticResource ChannelButtonStyle}" />
                            <Button Content="CH 06" Margin="2" Padding="4,6" Click="Channel_Click" Tag="6" Style="{StaticResource ChannelButtonStyle}" />
                            <Button Content="CH 07" Margin="2" Padding="4,6" Click="Channel_Click" Tag="7" Style="{StaticResource ChannelButtonStyle}" />
                            <Button Content="🚨 ALL" Margin="2" Padding="4,6" Click="Channel_Click" Tag="255" Style="{StaticResource AllCallButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Lower Command Deck (Tabbed Switcher: Roster vs Chat & Files) -->
                <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" 
                        CornerRadius="10" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Tab Switcher Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Content Area -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Tab Switcher Bar -->
                        <Border Grid.Row="0" Background="#161821" CornerRadius="8" Padding="3" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Roster Tab Button -->
                                <Button Grid.Column="0" Click="RosterTab_Click" Margin="0,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0,6" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRosterTabActive}" Value="True">
                                                    <Setter Property="Background" Value="#252834" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentEmerald}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="👥 ONLINE COLLEAGUES" />
                                        <TextBlock Text="{Binding OnlinePeerCount, StringFormat=' ({0})'}" />
                                    </StackPanel>
                                </Button>

                                <!-- Chat & Files Tab Button -->
                                <Button Grid.Column="1" Click="ChatTab_Click" Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0,6" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChatTabActive}" Value="True">
                                                    <Setter Property="Background" Value="#252834" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentEmerald}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasUnreadChat}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentAmber}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ChatTabHeader}" />
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource BrushAccentAmber}" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnreadChat}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content Area (Row 1) -->
                        <Grid Grid.Row="1">
                            <!-- ============================================== -->
                            <!-- TAB 1: ONLINE COLLEAGUES ROSTER                -->
                            <!-- ============================================== -->
                            <Grid Visibility="{Binding IsRosterTabActive, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Peers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#252833" CornerRadius="6" Padding="8,6" Margin="0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Status Dot: Amber when AFK, Emerald when Active -->
                                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource BrushAccentEmerald}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAfk}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushAccentAmber}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        
                                                        <!-- Display Name + AFK status & optional original machine name -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusDisplay}" 
                                                                       Foreground="{StaticResource BrushTextPrimary}" FontSize="12" 
                                                                       FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding OriginalNameDisplay, StringFormat=' {0}'}" 
                                                                       Foreground="{StaticResource BrushTextMuted}" FontSize="10" 
                                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                                       Visibility="{Binding HasCustomAlias, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        
                                                        <!-- Channel Tag -->
                                                        <TextBlock Grid.Column="2" Text="{Binding ChannelId, StringFormat='CH {0:D2}'}" 
                                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        
                                                        <!-- Targeted Mention / Page, Rename & Whisper Buttons -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                            <Button Content="✏️" Click="RenamePeer_Click"
                                                                    Background="#1E2330" Foreground="{StaticResource BrushTextMuted}" 
                                                                    BorderBrush="#363C4E" BorderThickness="1"
                                                                    Padding="5,2" FontSize="10" Cursor="Hand" Margin="0,0,4,0"
                                                                    ToolTip="Edit nickname for this colleague (Persistent)" />
                                                            <Button Content="🟣 WHISPER" Click="WhisperPeer_Click"
                                                                    Background="#2A1733" Foreground="#E879F9" 
                                                                    BorderBrush="#4C255E" BorderThickness="1"
                                                                    Padding="6,2" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="0,0,4,0"
                                                                    ToolTip="Open a 1-on-1 private walkie-talkie line with this colleague" />
                                                            <Button Content="🔔 PAGE" Click="PagePeer_Click"
                                                                    Background="#1E2330" Foreground="{StaticResource BrushAccentAmber}" 
                                                                    BorderBrush="#363C4E" BorderThickness="1"
                                                                    Padding="6,2" FontSize="10" FontWeight="Bold" Cursor="Hand"
                                                                    ToolTip="Send an urgent paging alert sound and notification to this colleague" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- ============================================== -->
                            <!-- TAB 2: INSTANT MESSAGING & FILE TRANSFERS      -->
                            <!-- ============================================== -->
                            <Grid Visibility="{Binding IsChatTabActive, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <!-- Chat Target & Folder Bar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Messages Stream -->
                                    <RowDefinition Height="*" />
                                    <!-- Bottom Input Bar -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Chat Target Header & Downloads Folder Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="SENDING TO:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Border Background="#1C2321" BorderBrush="#2D483A" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding CurrentChatTargetDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" />
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="📁 Downloads" Click="OpenDownloadsFolder_Click"
                                            Background="#252834" Foreground="{StaticResource BrushTextMuted}" BorderThickness="0"
                                            Padding="8,3" FontSize="10" Cursor="Hand" ToolTip="Open received downloads directory" />
                                </Grid>

                                <!-- Messages Stream ScrollViewer -->
                                <Grid Grid.Row="1">
                                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding DisplayMessages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="1" Padding="9,7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                                <Setter Property="Background" Value="#20232D" />
                                                                <Setter Property="BorderBrush" Value="#303545" />
                                                                <Setter Property="CornerRadius" Value="10,10,10,2" />
                                                                <Setter Property="Margin" Value="2,3,28,3" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                                        <Setter Property="Background" Value="#173123" />
                                                                        <Setter Property="BorderBrush" Value="#25543A" />
                                                                        <Setter Property="CornerRadius" Value="10,10,2,10" />
                                                                        <Setter Property="Margin" Value="28,3,2,3" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Header: Sender, Badges, Time, Ack -->
                                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding SenderName}" FontWeight="Bold" FontSize="11" Margin="0,0,6,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentEmerald}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#6EE7B7" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <Border Visibility="{Binding IsWhisper, Converter={StaticResource BoolToVis}}" 
                                                                            Background="#3A1747" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                                        <TextBlock Text="PRIVATE" FontSize="9" FontWeight="Bold" Foreground="#E879F9" />
                                                                    </Border>

                                                                    <TextBlock Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVis}}" 
                                                                               Text="🔒" FontSize="10" ToolTip="End-to-End Encrypted (AES-256-GCM)" Margin="0,0,4,0" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,4,0" />
                                                                    <TextBlock Text="✓" FontSize="9" FontWeight="Bold" ToolTip="Delivered">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsOutgoing}" Value="True" />
                                                                                            <Condition Binding="{Binding IsDelivered}" Value="True" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentEmerald}" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Text Message Body -->
                                                            <TextBlock Grid.Row="1" Text="{Binding Text}" 
                                                                       Visibility="{Binding Text, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                                                       TextWrapping="Wrap" Foreground="#F0F2F5" FontSize="12" LineHeight="16" Margin="0,1,0,2" />

                                                            <!-- Attachment Card (Photos, Videos, Files) -->
                                                            <Border Grid.Row="2" Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}" 
                                                                    Background="#12141A" BorderBrush="#252936" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,4,0,0">
                                                                <StackPanel>
                                                                    <!-- In-Line Image Preview Thumbnail (Photos) -->
                                                                    <Border Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" 
                                                                            CornerRadius="4" ClipToBounds="True" Background="#0C0D10" Margin="0,0,0,6">
                                                                        <Image Source="{Binding ThumbnailBase64, Converter={StaticResource Base64ImageConverter}}" 
                                                                               MaxHeight="140" MaxWidth="220" Stretch="Uniform" Cursor="Hand" 
                                                                               MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                                                               ToolTip="Click to open image" />
                                                                    </Border>

                                                                    <!-- File Info Row -->
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="📄" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                            <Setter Property="Text" Value="🖼️" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                            <Setter Property="Text" Value="🎬" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="11" Foreground="#F0F2F5" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                                                        </StackPanel>

                                                                        <!-- Completed Actions: Open File -->
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsTransferCompleted, Converter={StaticResource BoolToVis}}">
                                                                            <Button Content="Open" Click="OpenFile_Click"
                                                                                    Background="#252834" Foreground="{StaticResource BrushAccentEmerald}" 
                                                                                    BorderBrush="#384052" BorderThickness="1" Padding="7,2" FontSize="10" FontWeight="Bold" Cursor="Hand"
                                                                                    ToolTip="Open file in default application" />
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Real-Time Transfer Progress Bar -->
                                                                    <StackPanel Visibility="{Binding IsFileTransferInProgress, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                                                        <Grid Margin="0,0,0,2">
                                                                            <TextBlock Text="Transferring..." FontSize="9" Foreground="{StaticResource BrushAccentAmber}" HorizontalAlignment="Left" />
                                                                            <TextBlock Text="{Binding TransferPercentText}" FontSize="9" Foreground="{StaticResource BrushAccentAmber}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding TransferProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" 
                                                                                     Foreground="{StaticResource BrushAccentEmerald}" Background="#20232B" BorderThickness="0" />
                                                                    </StackPanel>

                                                                    <!-- Transfer Failure Notice -->
                                                                    <TextBlock Visibility="{Binding IsTransferFailed, Converter={StaticResource BoolToVis}}" 
                                                                               Text="⚠️ Transfer failed" FontSize="10" Foreground="#FF6B72" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Empty State Hint -->
                                    <TextBlock Text="No messages yet. Drop files or type below to chat." 
                                               Foreground="#505464" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayMessages.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Bottom Chat Input Bar -->
                                <Border Grid.Row="2" Background="#161821" BorderBrush="#2C303E" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Attachment Button -->
                                        <Button Grid.Column="0" Content="📎" Click="AttachFile_Click" 
                                                Width="30" Height="32" VerticalAlignment="Bottom" Margin="0,0,6,0"
                                                Background="#232632" Foreground="#A0A5B5" BorderThickness="0" 
                                                FontSize="13" Cursor="Hand" ToolTip="Send file, photo, or video (or drop files onto window)" />

                                        <!-- Chat Input TextBox -->
                                        <TextBox Grid.Column="1" x:Name="ChatInputTextBox" 
                                                 Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}" 
                                                 PreviewKeyDown="ChatInputTextBox_PreviewKeyDown"
                                                 MinHeight="32" MaxHeight="80" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" Padding="8,5" Background="#121316" Foreground="#F0F2F5" 
                                                 BorderBrush="#2B2E3A" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" />

                                        <!-- Send Button -->
                                        <Button Grid.Column="2" Content="➤" Click="SendMessage_Click" 
                                                Width="32" Height="32" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                                Background="{StaticResource BrushAccentEmerald}" Foreground="#121316" 
                                                FontWeight="Bold" BorderThickness="0" FontSize="12" Cursor="Hand" 
                                                ToolTip="Send message (Enter)" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- SETTINGS DROPDOWN DRAWER (OVERLAY DROPDOWN UNDER BANNER)  -->
            <!-- ======================================================== -->
            <Border x:Name="SettingsDrawer" 
                    Visibility="{Binding SettingsVisibility}"
                    VerticalAlignment="Top" 
                    Background="#161820" 
                    BorderBrush="#363A48" 
                    BorderThickness="1,0,1,1" 
                    CornerRadius="0,0,14,14" 
                    Margin="10,0,10,0" 
                    Padding="16,14"
                    PreviewMouseDown="SettingsDrawer_PreviewMouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.85" />
                </Border.Effect>

                <StackPanel>
                    <!-- Settings Header Bar -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙ AUDIO &amp; DEVICE SETTINGS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccentEmerald}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕ Close" Click="CloseSettings_Click"
                                Background="#252834" Foreground="#8A8F9E" BorderThickness="0"
                                Padding="8,3" FontSize="10" Cursor="Hand" />
                    </Grid>

                    <Separator Background="#262A36" Margin="0,0,0,10" />

                    <!-- PTT Hotkey Setting -->
                    <TextBlock Text="HOLD-TO-TALK (PTT) KEY" FontSize="10" FontWeight="Bold" Foreground="#A5AAB8" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding PttKeyPresets}" SelectedItem="{Binding SelectedPttPreset}"
                                  Height="32" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{Binding RebindButtonText}" Click="RecordKey_Click"
                                Background="#28323B" Foreground="{StaticResource BrushAccentEmerald}" 
                                FontWeight="Bold" BorderThickness="1" BorderBrush="#00E676" 
                                Padding="12,0" Height="32" FontSize="11" Cursor="Hand"
                                ToolTip="Click and press any keyboard key to bind custom PTT key" />
                    </Grid>

                    <!-- Roger Beep Tone -->
                    <TextBlock Text="ROGER BEEP TONE (END OF TRANSMISSION)" FontSize="10" FontWeight="Bold" Foreground="#A5AAB8" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RogerBeepOptions}" SelectedItem="{Binding SelectedRogerBeep}"
                              Height="32" Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RogerBeepDescConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Corporate Relay IP -->
                    <TextBlock Text="CORPORATE RELAY HOST / IP (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#A5AAB8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding RelayHost, UpdateSourceTrigger=PropertyChanged}" 
                             Height="32" Margin="0,0,0,4"
                             ToolTip="If office Wi-Fi blocks direct laptop pinging, enter the IP of any colleague running Lancom.Relay" />
                    <TextBlock Text="Leave blank for direct peer-to-peer Wi-Fi broadcast." 
                                FontSize="10" Foreground="#656978" Margin="0,0,0,10" />

                    <!-- VHF Radio DSP Filter -->
                    <Border Background="#1E212B" BorderBrush="#2C303E" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <CheckBox Content="Radio DSP VHF Filter (Tactical Walkie-Talkie Sound)" 
                                  IsChecked="{Binding EnableRadioFilter}" />
                    </Border>

                    <!-- E2EE Channel Encryption Passphrase -->
                    <TextBlock Text="CHANNEL ENCRYPTION KEY / PASSPHRASE (E2EE)" FontSize="10" FontWeight="Bold" Foreground="#A5AAB8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ChannelKey, UpdateSourceTrigger=PropertyChanged}" 
                             Height="32" Margin="0,0,0,4"
                             ToolTip="All colleagues using this exact passphrase communicate via hardware-accelerated AES-256-GCM. Leave blank for open channel." />
                    <TextBlock Text="Hardware-accelerated AES-256-GCM. Leave blank for standard open channel." 
                               FontSize="10" Foreground="#656978" Margin="0,0,0,10" />

                    <!-- Local Live Subtitles (Whisper AI) -->
                    <Border Background="#1E212B" BorderBrush="#2C303E" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Local AI Live Subtitles (Whisper Speech-to-Text)" 
                                      IsChecked="{Binding EnableSubtitles}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SttModelStatus}" FontSize="10" Foreground="#6EE7B7" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Save & Done Button -->
                    <Button Content="DONE" Click="CloseSettings_Click"
                            Background="{StaticResource BrushAccentEmerald}" Foreground="#121316" 
                            FontWeight="Bold" FontSize="11"
                            BorderThickness="0" Height="32" Cursor="Hand" />

                    <!-- Divider & Full Exit Button -->
                    <Separator Background="#262A36" Margin="0,14,0,10" />
                    <Button Content="🛑 QUIT LANCOM COMPLETELY" Click="QuitApp_Click"
                            Background="#381D22" Foreground="#FF6B72" 
                            FontWeight="Bold" FontSize="11"
                            BorderBrush="#552226" BorderThickness="1" Height="32" Cursor="Hand"
                            ToolTip="Completely exit the application (instead of minimizing to system tray)" />
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- RENAME PEER MODAL OVERLAY (PERSISTENT NICKNAME)          -->
            <!-- ======================================================== -->
            <Grid x:Name="RenameModalOverlay" Visibility="Collapsed" Background="#D90B0D13">
                <Border Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#161820" BorderBrush="#363A48" BorderThickness="1"
                        CornerRadius="10" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="✏️ EDIT COLLEAGUE NICKNAME" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccentEmerald}" Margin="0,0,0,6" />
                        <TextBlock x:Name="RenameMachineTargetText" Text="Original Host: Laptop-A" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" />
                        
                        <TextBlock Text="DISPLAY NAME / NICKNAME" FontSize="10" FontWeight="Bold" Foreground="#A5AAB8" Margin="0,0,0,4" />
                        <TextBox x:Name="RenameInputBox" Height="32" Margin="0,0,0,6" KeyDown="RenameInputBox_KeyDown" />
                        <TextBlock Text="This name will persist across app restarts on your machine." FontSize="10" Foreground="#656978" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="RESET" Click="ResetRename_Click"
                                    Background="Transparent" Foreground="#8A8F9E" BorderThickness="0"
                                    FontSize="10" HorizontalAlignment="Left" Cursor="Hand"
                                    ToolTip="Reset back to machine name" />
                            <Button Grid.Column="1" Content="CANCEL" Click="CancelRename_Click"
                                    Background="#252834" Foreground="#8A8F9E" BorderThickness="0"
                                    Padding="12,6" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand" />
                            <Button Grid.Column="2" Content="SAVE" Click="SaveRename_Click"
                                    Background="{StaticResource BrushAccentEmerald}" Foreground="#121316"
                                    BorderThickness="0" Padding="16,6" FontSize="11" FontWeight="Bold" Cursor="Hand" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
